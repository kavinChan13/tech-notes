# Normalise line endings so a Windows checkout stops printing
# "LF will be replaced by CRLF" on every `git add`, and so diffs stay stable
# regardless of who edits a file.
#
# Text is stored as LF in the repository. Working-copy endings are left to the
# platform (core.autocrlf) except where a tool needs LF.
* text=auto

# Always LF: these are read by shells, CI, or served verbatim.
*.sh          text eol=lf
*.py          text eol=lf
*.mjs         text eol=lf
*.js          text eol=lf
*.css         text eol=lf
*.html        text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.mdc         text eol=lf
*.xml         text eol=lf
*.txt         text eol=lf
.gitattributes text eol=lf
.gitignore    text eol=lf

# Binary: never touch, never diff.
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico         binary
*.woff        binary
*.woff2       binary

# Generated artefacts: keep them out of diffs and language stats.
assets/search-index.js   linguist-generated=true -diff
assets/vendor/*.js       linguist-vendored=true -diff
sitemap.xml              linguist-generated=true -diff
